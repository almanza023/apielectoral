# Configuración de 2Captcha para resolver reCAPTCHA
APIKEY_2CAPTCHA=tu_apikey_aqui

# Configuración de Proxies (NUEVO - Para evitar bloqueos de IP)
# Activa los proxies (true/false)
PROXY_ENABLED=false

# Lista de proxies separados por comas
# Formato: http://ip:puerto o http://usuario:contraseña@ip:puerto
# Ejemplo: http://proxy1.com:8080,http://proxy2.com:8080,http://usuario:pass@proxy3.com:3128
PROXY_LIST=

# Ejemplos de proxies gratuitos (NO recomendados para producción):
# PROXY_LIST=http://195.154.33.213:3128,http://203.89.5.226:8080,http://205.185.123.101:39611

# Ejemplos de proveedores recomendados:
# - Bright Data (brightdata.com): http://usuario:contraseña@proxy.provider.com:puerto
# - Oxylabs (oxylabs.io): http://usuario:contraseña@pr.oxylabs.io:7777
# - Smartproxy (smartproxy.com): http://usuario-pais:contraseña@gate.smartproxy.com:7000
# - Residential Proxies: Mejor para evitar bloqueos
